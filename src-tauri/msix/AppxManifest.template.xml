<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest template for Esuyo Markdown (Tauri Win32 full-trust app).

  NOTE: This file lives under src-tauri/msix/ (tracked) and NOT under
  src-tauri/gen/ (git-ignored, Tauri CLI output). Do not move it back.

  Placeholders are replaced by scripts/build-msix.ps1:
    __IDENTITY_NAME__           -> Partner Center Package Name, e.g. Esuyo.EsuyoMarkdown
    __PUBLISHER__               -> Partner Center Publisher, e.g. CN=8AC4B328-845D-4C1C-B1FC-CE52C08F4693
    __VERSION_QUAD__            -> 4-part version, e.g. 0.1.9.0 (semver + .0)
    __EXE_NAME__                -> built exe file name, e.g. esuyo-markdown.exe
    __ARCHITECTURE__            -> x64 or arm64 (matches -Architecture)
    __DISPLAY_NAME__            -> Esuyo Markdown
    __PUBLISHER_DISPLAY_NAME__  -> Esuyo
    __DESCRIPTION__             -> short description

  For Microsoft Store submission, upload the UNSIGNED .msix.
  Microsoft signs it automatically. Only self-sign for local testing.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">
  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__PUBLISHER__"
    Version="__VERSION_QUAD__"
    ProcessorArchitecture="__ARCHITECTURE__" />
  <Properties>
    <DisplayName>__DISPLAY_NAME__</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <!--
    Languages declared here are what the Microsoft Store shows in the product
    page's "Supported languages" section and what Partner Center reports under
    "Languages supported in packages". Keep this list in sync with the app's
    i18n locales in src/i18n/index.js. Codes must be Store-supported BCP-47
    tags (see docs/build-and-deployment.md). Esperanto (eo) and Burmese (my)
    are not supported by the Store, so they are intentionally omitted.
  -->
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="es" />
    <Resource Language="de" />
    <Resource Language="af" />
    <Resource Language="am" />
    <Resource Language="az-latn" />
    <Resource Language="be" />
    <Resource Language="bg" />
    <Resource Language="bn" />
    <Resource Language="bs" />
    <Resource Language="ca" />
    <Resource Language="cs" />
    <Resource Language="cy" />
    <Resource Language="da" />
